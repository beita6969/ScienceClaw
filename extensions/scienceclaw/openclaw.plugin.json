{
  "id": "scienceclaw",
  "name": "ScienceClaw Benchmark",
  "description": "Optional bridge to the isolated Python ScienceClaw benchmark package.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "repoRoot": { "type": "string" },
      "pythonBin": { "type": "string" },
      "runRoot": { "type": "string" },
      "dataRoot": { "type": "string" },
      "modelRoot": { "type": "string" },
      "timeoutMs": { "type": "integer", "minimum": 1000 },
      "maxStdoutBytes": { "type": "integer", "minimum": 4096 }
    }
  },
  "uiHints": {
    "repoRoot": { "label": "Benchmark package root", "help": "Path to packages/scienceclaw" },
    "pythonBin": { "label": "Python executable", "help": "Interpreter with the benchmark package installed" },
    "runRoot": { "label": "Run directory", "advanced": true },
    "dataRoot": { "label": "Dataset root", "advanced": true },
    "modelRoot": { "label": "Model weights root", "advanced": true },
    "timeoutMs": { "label": "Operation timeout (ms)", "advanced": true },
    "maxStdoutBytes": { "label": "Maximum response size (bytes)", "advanced": true }
  }
}
